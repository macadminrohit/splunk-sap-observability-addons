[
  {
    "name": "health",
    "provider": "HM_ANALYTICS_DP",
    "version": "v1",
    "columns": {
      "dimensions": ["serviceName", "serviceType", "metricName"],
      "metrics": [
        {"measure": "value", "method": "avg"},
        {"measure": "limit", "method": "avg"},
        {"measure": "usage", "method": "avg"},
        {"measure": "okStatus", "method": "avg"},
        {"measure": "warningStatus", "method": "avg"},
        {"measure": "criticalStatus", "method": "avg"}
      ]
    }
  },
  {
    "name": "jobs",
    "provider": "DP_JOB_MONITORING",
    "version": "v1",
    "columns": {
      "dimensions": ["serviceName", "jobName"],
      "metrics": [
        {"measure": "executions", "method": "sum"},
        {"measure": "success", "method": "sum"},
        {"measure": "warning", "method": "sum"},
        {"measure": "aborted", "method": "sum"},
        {"measure": "applicationWarning", "method": "sum"},
        {"measure": "applicationError", "method": "sum"},
        {"measure": "averageRunTime", "method": "avg"}
      ]
    }
  },
  {
    "name": "status_events",
    "provider": "EVENTS_DATA_SET",
    "version": "v1",
    "columns": {
      "dimensions": ["serviceName", "eventType", "eventStatus"],
      "metrics": [
        {"measure": "counter", "method": "sum"},
        {"measure": "duration", "method": "sum"}
      ]
    }
  }
]
